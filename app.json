{
  "expo": {
    "name": "Vigilancia de la Vía",
    "slug": "vigilancia-via",
    "version": "1.0.0",
    "scheme": "vigilancia-via",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a73e8"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "La app necesita acceso a la ubicación para registrar dónde ocurre el incidente."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a la galería para adjuntar fotos al reporte.",
          "cameraPermission": "La app necesita acceso a la cámara para fotografiar el incidente."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "La app necesita acceso a la cámara."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1a73e8",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Vigilancia de la Vía"
        }
      ],
      "expo-asset",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1a73e8"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCSJfseY2QKnMNGLP5MClVolLc5FMNxf_g"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.pablodev3.vigilanciavia",
      "newArchEnabled": true
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "La app necesita la ubicación para registrar el incidente.",
        "NSCameraUsageDescription": "La app necesita la cámara para fotografiar el incidente.",
        "NSPhotoLibraryUsageDescription": "La app necesita acceso a la galería para adjuntar fotos."
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c1d3b653-c954-45f0-aca5-0f7f1157402c"
      }
    }
  }
}
